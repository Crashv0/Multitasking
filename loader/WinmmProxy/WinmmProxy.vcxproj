<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F1E2B7A-3C4D-4E8F-9A0B-1C2D3E4F5A6B}</ProjectGuid>
    <RootNamespace>WinmmProxy</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.props" />
  </ImportGroup>
  <PropertyGroup>
    <TargetName>winmm</TargetName>
    <OutDir>$(MSBuildProjectDirectory)\bin\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- With /Brepro and no symbol file, the DLL is the same bytes from any folder on any day, and names no
           folder of the machine that built it. A symbol file would bring both back. -->
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <ModuleDefinitionFile>exports.def</ModuleDefinitionFile>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <!-- Reads each Loader copy's version from its DLL. -->
      <AdditionalDependencies>version.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="proxy.cpp" />
    <MASM Include="$(MSBuildProjectDirectory)\thunks.asm" />
    <None Include="exports.def" />
    <ClInclude Include="exports.inc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" />
  </ImportGroup>
  <Target Name="DeployProxy" AfterTargets="Build" Condition="'$(Deploy)' != 'false' and '$(MelvorGame)' != '' and Exists('$(MelvorGame)')">
    <Copy SourceFiles="$(OutDir)winmm.dll" DestinationFolder="$(MelvorGame)" Retries="0" />
    <Message Importance="high" Text="Deployed winmm.dll to $(MelvorGame)" />
  </Target>
</Project>
